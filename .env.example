# Copy to .env (cp .env.example .env). Values below match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://vidcraft:vidcraft@localhost:5442/vidcraft

# SeaweedFS locally (docker-compose). For Cloudflare R2: STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, STORAGE_REGION=auto
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_BUCKET=vidcraft
STORAGE_ACCESS_KEY=vidcraft
STORAGE_SECRET_KEY=vidcraft-secret
STORAGE_REGION=us-east-1

# API
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Worker
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
