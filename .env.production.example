# Copy to .env.production and fill in. Used by docker-compose.prod.yml. Never commit the filled-in file.

# Public address of the site, used for CORS on the credentialed endpoints.
WEB_ORIGIN=https://vidcraft.example.com
WEB_PORT=8080

# Postgres (created by the compose file). Use a long random password.
POSTGRES_USER=vidcraft
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vidcraft
DATABASE_URL=postgres://vidcraft:change-me@postgres:5432/vidcraft

# Sessions. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Object storage: Cloudflare R2 shown. Two buckets: a private one, and one made publicly readable
# (R2: enable the public domain on it) for video playlists and segments.
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=vidcraft
STORAGE_MEDIA_BUCKET=vidcraft-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# The public address of the media bucket (its R2 public domain or a CDN in front of it).
MEDIA_BASE_URL=https://media.vidcraft.example.com

LOG_LEVEL=info
# Leave WEBHOOK_ALLOW_PRIVATE unset: it would let users make your server call your internal network.
